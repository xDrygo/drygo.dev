---
import Links from "@/components/index/Links.astro";

const sideImages = [
  {
    name: "baguette.jpeg",
    src: "/images/hero/baguette.webp",
    style: "top-[3%] left-[11%] w-60",
  },
  {
    name: "dev33.jpeg",
    src: "/images/hero/dev33.webp",
    style: "top-[33%] left-[2%] w-70",
  },
  {
    name: "capihuana.jpeg",
    src: "/images/hero/sector_x.webp",
    style: "top-[63%] left-[12%] w-75",
  },
  {
    name: "uhc.jpeg",
    src: "/images/hero/uhc.webp",
    style: "top-[5%] right-[7%] w-72",
  },
  {
    name: "clown.jpeg",
    src: "/images/hero/clown.webp",
    style: "top-[36%] right-[2%] w-65",
  },
  {
    name: "dreamcore.jpeg",
    src: "/images/hero/dreamcore.webp",
    style: "top-[63%] right-[12%] w-52",
  },
];
---

<section
  id="inicio"
  class="w-full min-h-[calc(100vh-40px)] relative flex flex-col items-center justify-center gap-6 py-12 overflow-hidden"
>
  {
    sideImages.map((img) => (
      <div
        class={`side-image absolute border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform hover:-translate-y-1 hover:scale-101 ${img.style}`}
      >
        <div class="h-7 bg-[#573070] flex items-center justify-between px-2">
          <span class="text-white text-xs font-bold truncate pr-1">
            {img.name}
          </span>
          <button
            data-close
            aria-label="Cerrar ventana"
            class="w-5 h-5 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white shrink-0"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="square"
              class="w-2.5 h-2.5 text-black"
            >
              <>
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </>
            </svg>
          </button>
        </div>
        <div class="p-2">
          <div class="border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white bg-[#241a2e]">
            <img
              src={img.src}
              alt={img.name}
              class="w-full h-auto object-cover p-1"
            />
          </div>
        </div>
      </div>
    ))
  }

  <!-- Centro -->
  <div
    class="flex flex-col items-center gap-4 sm:gap-6 z-10 w-full px-4 sm:px-8 2xl:w-auto 2xl:px-0 max-w-3xl"
  >
    <div
      class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform 2xl:hover:-translate-y-1 2xl:hover:scale-101 w-full 2xl:w-auto"
    >
      <div class="h-8 bg-[#573070] flex items-center justify-between px-2">
        <span class="text-white text-sm font-bold">33drygo.exe</span>
        <button
          data-close
          aria-label="Cerrar ventana"
          class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="square"
            class="w-3 h-3 text-black"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="p-2 sm:p-4">
        <div
          class="border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white bg-[#241a2e] py-2 px-3 sm:py-4 sm:px-6"
        >
          <img
            fetchpriority="high"
            src="/images/33drygo.webp"
            alt="33drygo"
            class="w-full max-w-[520px] mx-auto h-auto object-contain"
          />
        </div>
      </div>
    </div>
    <Links />
  </div>

  <button
    aria-label="Scroll button"
    id="scroll-button"
    class="absolute bottom-20 z-30 border-2 border-t-white border-l-white border-b-black border-r-black bg-gray-300 px-3 py-2 hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white animate-bounce"
    onclick="document.getElementById('resume')?.scrollIntoView({ behavior: 'smooth' })"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 7 7"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      shape-rendering="crispEdges"
    >
      <rect x="3" y="0" width="1" height="4" fill="black"></rect>
      <rect x="1" y="3" width="5" height="1" fill="black"></rect>
      <rect x="2" y="4" width="3" height="1" fill="black"></rect>
      <rect x="3" y="5" width="1" height="1" fill="black"></rect>
    </svg>
  </button>
</section>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const scrollButton = document.getElementById("scroll-button");

    function updateButtonVisibility() {
      if (!scrollButton) return;
      scrollButton.style.opacity = window.scrollY < 100 ? "1" : "0";
      scrollButton.style.pointerEvents = window.scrollY < 100 ? "auto" : "none";
    }

    function updateImages() {
      const images = document.querySelectorAll<HTMLElement>(".side-image");
      const w = window.innerWidth;

      if (w >= 1200) {
        // 2xl: posiciones originales de Tailwind
        images.forEach((img) => {
          if ("closed" in img.dataset) return;
          img.style.display = "";
          img.style.width = "";
          img.style.top = "";
          img.style.bottom = "";
          img.style.left = "";
          img.style.right = "";
          img.style.opacity = "1";
        });
        return;
      }

      // < 2xl: reposicionar arriba y abajo, 3 por fila
      const topPositions: {
        top: string;
        bottom: string;
        left: string;
        right: string;
      }[] = [
        { top: "15%", bottom: "auto", left: "2%", right: "auto" },
        { top: "15%", bottom: "auto", left: "35%", right: "auto" },
        { top: "15%", bottom: "auto", left: "auto", right: "2%" },
      ];
      const bottomPositions: {
        top: string;
        bottom: string;
        left: string;
        right: string;
      }[] = [
        { top: "auto", bottom: "15%", left: "2%", right: "auto" },
        { top: "auto", bottom: "15%", left: "35%", right: "auto" },
        { top: "auto", bottom: "15%", left: "auto", right: "2%" },
      ];

      // Opacidad según ancho
      let opacity: string;
      if (w <= 480) {
        opacity = "0.15";
      } else if (w <= 768) {
        opacity = "0.3";
      } else {
        opacity = "0.5";
      }

      images.forEach((img, i) => {
        if ("closed" in img.dataset) return;
        img.style.display = "block";
        img.style.width = "28%";
        img.style.opacity = opacity;

        const pos = i < 3 ? topPositions[i] : bottomPositions[i - 3];
        img.style.top = pos.top;
        img.style.bottom = pos.bottom;
        img.style.left = pos.left;
        img.style.right = pos.right;
      });
    }

    if (scrollButton) {
      window.addEventListener("scroll", updateButtonVisibility);
      window.addEventListener("load", updateButtonVisibility);
    }

    window.addEventListener("resize", updateImages);
    updateImages();
  });
</script>
