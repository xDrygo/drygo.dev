---
const links = [
  {
    label: "Comisiones",
    url: "/comissions",
    img: "/images/links/comissions.png",
    imgSize: 32,
    internal: true,
  },
  {
    label: "Proyectos",
    url: "/projects",
    img: "/images/links/projects.png",
    imgSize: 32,
    internal: true,
  },
  {
    label: "Email",
    copy: "contact.drygo@gmail.com",
    img: "/images/links/email.png",
    imgSize: 32,
  },
  {
    label: "GitHub",
    url: "https://link.drygo.dev/github",
    img: "/images/links/github.png",
    imgSize: 32,
  },
  {
    label: "Streams",
    url: "https://link.drygo.dev/kick",
    img: "/images/links/streams.png",
    imgSize: 32,
  },
];
---

<section
  class="border-2 border-gray-400 bg-gray-300 mx-auto shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] max-w-full transition-transform hover:translate-y-1 hover:scale-101"
>
  <div class="h-8 bg-[#573070] flex items-center justify-between px-2">
    <span class="text-white text-sm font-bold truncate pr-2"
      >links_importantes.exe</span
    >
    <button
      aria-hidden="true"
      tabindex="-1"
      class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 shrink-0"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="square"
        class="w-3 h-3 text-black"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    id="links-scroll"
    class="px-2 py-1 border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-2 bg-white overflow-x-auto"
  >
    <div class="flex gap-1">
      {
        links.map((link) =>
          link.copy ? (
            <button
              data-copy={link.copy}
              class="copy-btn appearance-none flex flex-col items-center gap-1 px-3 py-2 text-black hover:bg-[#021a94] hover:text-white cursor-pointer select-none w-18 relative shrink-0"
            >
              <img
                src={link.img}
                alt={link.label}
                width={link.imgSize}
                height={link.imgSize}
                style="image-rendering: pixelated"
              />
              <span class="text-[10px] font-bold text-center leading-tight">
                {link.label}
              </span>
              <span class="copied-toast absolute -top-6 left-1/2 -translate-x-1/2 bg-black text-white text-[9px] px-1.5 py-0.5 whitespace-nowrap opacity-0 pointer-events-none transition-opacity">
                ¡Copiado!
              </span>
            </button>
          ) : (
            <a
              href={link.url}
              target={link.internal ? undefined : "_blank"}
              rel={link.internal ? undefined : "noopener noreferrer"}
              class="flex flex-col items-center gap-1 px-3 py-2 text-black hover:bg-[#021a94] hover:text-white cursor-pointer select-none w-18"
            >
              <img
                src={link.img}
                alt={link.label}
                width={link.imgSize}
                height={link.imgSize}
                style="image-rendering: pixelated"
              />
              <span class="text-[10px] font-bold text-center leading-tight">
                {link.label}
              </span>
            </a>
          ),
        )
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy!;
      await navigator.clipboard.writeText(text);
      const toast = btn.querySelector<HTMLElement>(".copied-toast");
      if (!toast) return;
      toast.style.opacity = "1";
      setTimeout(() => (toast.style.opacity = "0"), 1500);
    });
  });
  window.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("links-scroll");
    if (!el) return;
    el.scrollLeft = (el.scrollWidth - el.clientWidth) / 2;
  });
</script>
