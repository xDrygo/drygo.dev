---
// index/Resume.astro
import SkinModel from "@/components/SkinModel.astro";
---

<section class="w-full max-w-4xl mx-auto">
  <div
    class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col transition-transform hover:-translate-y-1 hover:scale-101"
  >
    <!-- Barra de título -->
    <div
      class="h-8 bg-[#573070] flex items-center justify-between px-2 shrink-0"
    >
      <span class="text-white text-sm font-bold">about.txt</span>
      <button
        aria-hidden="true"
        tabindex="-1"
        class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          class="w-3 h-3 text-black"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Cuerpo: texto + skin -->
    <div class="flex flex-col sm:flex-row">
      <!-- Texto -->
      <div class="flex-1 p-4 space-y-3 flex flex-col font-family-comic">
        <div
          class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-3 shrink-0"
        >
          <h2 class="text-lg sm:text-2xl font-bold text-black">
            hey soy drygoooo
          </h2>
        </div>
        <div
          class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-3 flex-1"
        >
          <p class="text-sm text-black leading-relaxed">
            Soy un desarrollador actualmente enfocado en Minecraft, además de
            organizador y configurador de eventos en el mismo.
          </p>
          <p class="text-sm text-black leading-relaxed mt-2">
            Ex-Owner de Turtle Club, principal desarrollador de Sector X y +3
            años de experiencia en el desarrollo en Minecraft.
          </p>
          <p class="text-sm text-black leading-relaxed mt-2">
            Vivo en México, mi zona horaria es UTC-8
          </p>
        </div>
      </div>

      <!-- Skin 9:16 -->
      <div class="shrink-0 p-3 flex items-center justify-center sm:justify-end">
        <div
          class="border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white bg-[#241a2e] w-full sm:w-[180px] sm:aspect-9/16"
        >
          <SkinModel
            uuid="2627e853-3c47-4790-905f-e7697b36b9d9"
            rotate={true}
          />
        </div>
      </div>
    </div>
  </div>
</section>
