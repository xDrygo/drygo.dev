---
// index/Music.astro

const tracks = [
  {
    name: "teselia.mp3",
    display: "teselia",
    cover: "/images/music/teselia.webp",
    artists: ["suei", "Miji"],
    url: "https://open.spotify.com/track/4015KZbD5yCsbchSv4RKeH"
  },
  {
    name: "naif.mp3",
    display: "naif",
    cover: "/images/music/aun_no_he_terminado.webp",
    artists: ["STRANGEHUMAN", "suei"],
    url: "https://open.spotify.com/track/5miRiXqKiP2EeBv85DWRY5"
  },
  {
    name: "mal_comunicada.mp3",
    display: "mal comunicada",
    cover: "/images/music/epistolaresplus.webp",
    artists: ["AKRIILA", "LATIN MAFIA"],
    url: "https://open.spotify.com/track/3q4UXDFDa6is0TDHhZJ70e"
  },
  {
    name: "siento_que_merezco_mas.mp3",
    display: "Siento que merezco más",
    cover: "/images/music/todos_los_dias_todo_el_dia.webp",
    artists: ["LATIN MAFIA"],
    url: "https://open.spotify.com/track/4Z6pPinNzkGtbgAlE88263"
  }
];
---

<section class="w-full max-w-7xl mx-auto">
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {tracks.map((track) => (
      <div class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col transition-transform hover:-translate-y-1 hover:scale-101">

        <!-- Barra de título -->
        <div class="h-7 bg-[#573070] flex items-center justify-between px-2 shrink-0">
          <span class="text-white text-xs font-bold truncate pr-1">{track.name}</span>
          <button aria-hidden="true" tabindex="-1" class="w-5 h-5 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center shrink-0 hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" class="w-2.5 h-2.5 text-black">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Contenido -->
        <div class="p-2 flex flex-col flex-1 gap-2">

          <!-- Cover -->
          <div class="border-2 border-black shrink-0">
            <img
              src={track.cover}
              alt={track.name}
              class="w-full aspect-square object-cover"
            />
          </div>

          <!-- Nombre + Artistas -->
          <div class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white px-2 py-1.5 flex-1">
            <p class="text-sm text-black font-bold mb-0.5 font-family-comic">{track.display}</p>
<p class="text-[10px] text-gray-500 font-bold tracking-wide mb-0.5">ARTISTAS</p>
            <p class="text-xs text-black font-bold leading-snug ">
              {track.artists.join(", ")}
            </p>
          </div>

          <!-- Botón Spotify -->
          <div class="flex justify-end shrink-0">
            <a
              href={track.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-3 py-1 bg-gray-300 border-2 border-t-white border-l-white border-b-black border-r-black text-black font-bold text-xs hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white transition-transform hover:scale-103"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
              </svg>
              Escuchar →
            </a>
          </div>

        </div>
      </div>
    ))}
  </div>
</section>