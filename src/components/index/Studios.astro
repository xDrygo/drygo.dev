---
const studios = [
  {
    name: "Koryfi Studio",
    role: "Fundador, Desarrollo, Diseño",
    logo: "/images/studios/koryfi.webp",
    color: "#51acbd",
  },
  {
    name: "Jose90",
    role: "Eventos, Discord Bot, Plugins, Discord",
    logo: "/images/studios/jose90.webp",
    color: "#443555",
  },
  {
    name: "Turtle Club",
    role: "Ex-Owner, Plugins, Web, Discord",
    logo: "/images/studios/turtle.webp",
    color: "#8ba35b",
  },
  {
    name: "Owen Studios",
    role: "Plugins",
    logo: "/images/studios/owen.webp",
    color: "#a35b62",
  },
  {
    name: "Nebula Community",
    role: "Discord Bot",
    logo: "/images/studios/nebula.webp",
    color: "#8B5DA6",
  },
];
---

<section class="w-full max-w-3xl mx-auto">
  <div
    class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform hover:-translate-y-1 hover:scale-101"
  >
    <!-- Barra de título -->
    <div
      class="h-8 bg-[#573070] flex items-center justify-between px-2 shrink-0"
    >
      <span class="text-white text-sm font-bold">people_i_worked_with.exe</span>
      <button
        aria-hidden="true"
        tabindex="-1"
        class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="square"
          class="w-3 h-3 text-black"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Contenido -->
    <div class="p-3 sm:p-4">
      <div
        class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-3 mb-3 sm:mb-4"
      >
        <p
          class="text-xs sm:text-sm text-black leading-relaxed text-center font-family-comic"
        >
          A lo largo de mi carrera he trabajado y colaborado con estudios y
          creadores de la comunidad de Minecraft.
        </p>
      </div>

      <!-- Mobile: lista horizontal scrolleable -->
      <div class="flex sm:hidden gap-3 overflow-x-auto pb-2 scrollbar-none">
        {
          studios.map((studio) => (
            <div
              class="studio-card border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 bg-gray-300 p-2 flex flex-col items-center gap-1.5 text-center shrink-0 w-24 duration-150"
              style={`--studio-color: ${studio.color}`}
            >
              <div class="border-2 border-black w-12 h-12 shrink-0 overflow-hidden">
                <img
                  src={studio.logo}
                  alt={studio.name}
                  class="w-full h-full object-cover"
                />
              </div>
              <div>
                <p class="text-[10px] font-bold text-black leading-tight">
                  {studio.name}
                </p>
                <p class="text-[9px] text-gray-600 mt-0.5 leading-tight">
                  {studio.role}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Desktop: grid -->
      <div class="hidden sm:grid grid-cols-3 md:grid-cols-5 gap-3">
        {
          studios.map((studio) => (
            <div
              class="studio-card border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 bg-gray-300 p-3 flex flex-col items-center gap-2 text-center duration-150 transition-transform hover:-translate-y-1 hover:scale-101"
              style={`--studio-color: ${studio.color}`}
            >
              <div class="border-2 border-black w-14 h-14 shrink-0 overflow-hidden">
                <img
                  src={studio.logo}
                  alt={studio.name}
                  class="w-full h-full object-cover"
                />
              </div>
              <div>
                <p class="text-xs font-bold text-black leading-tight">
                  {studio.name}
                </p>
                <p class="text-xs text-gray-600 mt-0.5">{studio.role}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .studio-card:hover {
    background-color: var(--studio-color) !important;
  }
  .studio-card:hover p {
    color: white !important;
  }
</style>
