---
// comissions/Services.astro
const services = [
  {
    name: "progamación_plugins.exe",
    title: "Programación de Plugins",
    image: "/images/services/programacion_plugins.webp",
    tags: ["Programación", "Spigot/Paper", "Plugins"],
    description:
      "Puedo programar cualquier clase de plugins de Minecraft, ya sean sistemas de Whitelist, Scoreboard, minijuegos o lo que se te ocurra.",
  },
  {
    name: "config_optimizacion_servidor.exe",
    title: "Config/Optimizacion de Servidor",
    image: "/images/services/config_optimizacion_servidor.webp",
    tags: ["Config.", "Plugins", "Optimización"],
    description:
      "¿Configurar un servidor? ¡Puedo ayudarte con eso! Desde minijuegos, plugins descargados, o hasta optimizarlos para algun evento.",
  },
  {
    name: "desarrollo_eventos_series.exe",
    title: "Desarrollo de Eventos/Series",
    image: "/images/services/desarrollo_eventos_series.webp",
    tags: ["Eventos", "Series", "Proyectos"],
    description:
      "¡Te ayudaré para crear eventos o series!, ¿Tienes una idea para un evento?, ¿Quieres crear una serie de streamers? ¡Contactame!",
  },
  {
    name: "programacion_discord_bot.exe",
    title: "Programación Discord Bot",
    image: "/images/services/programacion_discord_bot.webp",
    tags: ["Programación", "Discord", "Custom"],
    description:
      "¿Necesitas un bot de discord para tu servidor? Te puedo ayudar con eso... ¡Desde whitelist en discord hasta sistemas de voicechat!",
  },
  {
    name: "desarrollo_web.exe",
    title: "Desarrollo Web",
    image: "/images/services/desarrollo_web.webp",
    tags: ["Web", "Custom", "SEO"],
    description:
      "¿Te gustaria una pagina web personal o para tu studio/proyecto? Yo mismo programé esta pagina web... ¡Y tu tambien podrias tener una propia!",
  },
];
---

<section class="w-full max-w-7xl mx-auto">
  <!-- Mobile: scroll horizontal de cards -->
  <div class="flex md:hidden gap-3 overflow-x-auto pb-2 scrollbar-none px-1">
    {
      services.map((service) => (
        <div class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col shrink-0 w-64">
          <div class="h-8 bg-[#573070] flex items-center justify-between px-2 shrink-0">
            <span class="text-white text-xs font-bold truncate pr-2">
              {service.name}
            </span>
            <button
              aria-hidden="true"
              tabindex="-1"
              class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="square"
                class="w-3 h-3 text-black"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>

          <img
            src={service.image}
            alt={service.name}
            class="w-full h-32 object-cover border-b-2 border-black"
          />

          <div class="p-2 flex flex-col flex-1 gap-2">
            <div class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-2 flex-1 font-family-comic">
              <p class="text-xs text-black leading-relaxed line-clamp-3">
                {service.description}
              </p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 min-w-0">
              <div class="flex gap-1 overflow-x-auto scrollbar-none flex-1 min-w-0">
                {service.tags.map((tag) => (
                  <span class="px-1.5 py-0.5 bg-gray-200 border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 text-[9px] font-bold text-black whitespace-nowrap shrink-0 cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Desktop: grid -->
  <div
    class="hidden md:grid grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center"
  >
    {
      services.map((service) => (
        <div class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col transition-transform hover:-translate-y-1 hover:scale-101 w-full">
          <div class="h-8 bg-[#573070] flex items-center justify-between px-2 shrink-0">
            <span class="text-white text-sm font-bold truncate pr-2">
              {service.name}
            </span>
            <button
              aria-hidden="true"
              tabindex="-1"
              class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="square"
                class="w-3 h-3 text-black"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>

          <img
            src={service.image}
            alt={service.name}
            class="w-full h-48 object-cover"
          />

          <div class="p-3 flex flex-col flex-1 gap-4">
            <div class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-2 flex-1 font-family-comic">
              <p class="text-sm text-black leading-relaxed">
                {service.description}
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0 min-w-0">
              <div class="flex gap-1.5 overflow-x-auto scrollbar-none flex-1 min-w-0">
                {service.tags.map((tag) => (
                  <span class="px-2 py-0.5 bg-gray-200 border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 text-xs font-bold text-black whitespace-nowrap shrink-0 cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
