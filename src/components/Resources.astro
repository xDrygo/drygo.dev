---
import GitHub from "./icons/GitHub.astro";
import Download from "./icons/Download.astro";

interface Resource {
  name: string;
  description: string;
  image: string;
  github: string;
  download: string;
}

const resources: Resource[] = [
  {
    name: "xWhitelist",
    description:
      "Implements a hybrid whitelist system with local storage, database support, and staff-only management commands.",
    image: "/images/resources/xwhitelist.webp",
    github: "https://github.com/xDrygo/xWhitelist",
    download: "https://github.com/xDrygo/xWhitelist/releases/latest",
  },
  {
    name: "xTeams",
    description:
      "Provides team management with API access, configurable team data, and commands for team assignment and control.",
    image: "/images/resources/xteams.webp",
    github: "https://github.com/xDrygo/xTeams",
    download: "https://github.com/xDrygo/xTeams/releases/latest",
  },
  {
    name: "xBossBar",
    description:
      "Manages global and per-player BossBars with placeholder support, dynamic updates for title, progress, color, and style.",
    image: "/images/resources/xbossbar.webp",
    github: "https://github.com/xDrygo/xBossBar",
    download: "https://github.com/xDrygo/xBossBar/releases/latest",
  },
  {
    name: "xSpawn",
    description:
      "Handles spawn points at global, team, and player levels, including overrides for first spawn and respawns, with API support.",
    image: "/images/resources/xspawn.webp",
    github: "https://github.com/xDrygo/xSpawn",
    download: "https://github.com/xDrygo/xSpawn/releases/latest",
  },
  {
    name: "xMusic",
    description:
      "Controls playback of sounds and playlists, with message triggers, delays, skip/stop actions, and configurable music cards.",
    image: "/images/resources/xmusic.webp",
    github: "https://github.com/xDrygo/xMusic",
    download: "https://github.com/xDrygo/xMusic/releases/latest",
  },
];
---

<h2 class="text-2xl font-bold mb-8 text-center">Resources I made</h2>
<div
  class="flex flex-col sm:grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 justify-center"
>
  {
    resources.map((resource) => (
      <div
        class="relative bg-white/5 w-full mx-auto rounded-xl shadow-md hover:shadow-xl transition-all duration-300
           flex flex-col sm:flex-col overflow-visible border-1 border-white/10 group hover:bg-white/10"
      >
        <div class="flex flex-row sm:flex-col p-3">
          {/* Imagen y botones HORIZONTAL */}
          <div class="flex flex-col w-24 h-auto sm:w-full sm:aspect-square flex-shrink-0 rounded-lg overflow-hidden">
            <div class="relative w-full h-full rounded-lg sm:rounded-t-none overflow-hidden border-1 border-white/50">
              <img
                src={resource.image}
                alt={resource.name}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
              />

              {/* Botones MODO VERTICAL (sm+) sobre la imagen */}
              <div class="hidden sm:flex absolute bottom-2 left-2 gap-2">
                <a
                  href={resource.github}
                  target="_blank"
                  aria-label={`GitHub repository for ${resource.name}`}
                  class="bg-black/70 text-white py-1 px-2 rounded-xl hover:bg-[#333]/70 transition-all hover:scale-105 flex items-center justify-center border-1 border-white/10"
                >
                  <GitHub class="size-5 sm:size-6" />
                </a>
                <a
                  href={resource.download}
                  target="_blank"
                  aria-label={`Download latest release of ${resource.name}`}
                  class="bg-black/70 text-white py-1 px-2 rounded-xl hover:bg-[#333]/70 transition-all hover:scale-105 flex items-center justify-center border-1 border-white/10"
                >
                  <Download class="size-5 sm:size-6" />
                </a>
              </div>
            </div>

            {/* Botones MODO HORIZONTAL (<sm) debajo de la imagen */}
            <div class="gap-1 mt-2 inline-flex sm:hidden mx-auto items-center">
              <a
                href={resource.github}
                target="_blank"
                aria-label={`GitHub repository for ${resource.name}`}
                class="bg-white/5 text-white py-2 px-3 rounded-xl hover:bg-white/10 transition-all hover:scale-105 flex items-center justify-center border-1 border-white/10"
              >
                <GitHub class="size-5" />
              </a>
              <a
                href={resource.download}
                target="_blank"
                aria-label={`Download latest release of ${resource.name}`}
                class="bg-white/5 text-white py-2 px-3 rounded-xl hover:bg-white/10 transition-all hover:scale-105 flex items-center justify-center border-1 border-white/10"
              >
                <Download class="size-5" />
              </a>
            </div>
          </div>

          {/* Contenido */}
          <div class="relative flex-1 ml-3 sm:ml-0 flex flex-col justify-center mt-0 sm:mt-3">
            <h3 class="text-lg font-semibold mb-1">{resource.name}</h3>
            <p class="text-white/70 text-sm sm:text-base">
              {resource.description}
            </p>
          </div>
        </div>
      </div>
    ))
  }
</div>
