---
const links = [
  {
    label: "Volver",
    url: "/",
    img: "/images/links/back.png",
    imgSize: 32,
    internal: true,
  },
];
---

<section
  class="border-2 border-gray-400 bg-gray-300 mx-auto shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform hover:translate-y-1 hover:scale-101 min-w-[50%]"
>
  <div class="h-8 bg-[#573070] flex items-center justify-between px-2">
    <span class="text-white text-sm font-bold">volver.exe</span>
    <button
      data-close
      aria-label="Cerrar ventana"
      class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="square"
        class="w-3 h-3 text-black"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    class="px-2 py-1 border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white m-2 bg-white"
  >
    <div class="flex gap-1 justify-center">
      {
        links.map((link) => (
          <a
            href={link.url}
            target={link.internal ? undefined : "_blank"}
            rel={link.internal ? undefined : "noopener noreferrer"}
            class="flex flex-col items-center gap-1 px-3 py-2 text-black hover:bg-[#021a94] hover:text-white cursor-pointer select-none"
          >
            <img
              src={link.img}
              alt={link.label}
              width={link.imgSize}
              height={link.imgSize}
              style="image-rendering: pixelated"
            />
            <span class="text-[10px] font-bold text-center leading-tight">
              {link.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy!;
      await navigator.clipboard.writeText(text);
      const toast = btn.querySelector<HTMLElement>(".copied-toast");
      if (!toast) return;
      toast.style.opacity = "1";
      setTimeout(() => (toast.style.opacity = "0"), 1500);
    });
  });
</script>
