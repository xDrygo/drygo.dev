  },
  {
    name: "sulfurlab.exe",
    image: "/images/projects/sulfurlab.webp",
    tags: ["Sulfur Cube", "Admin.", "Laboratory"],
    description: "SulfurLab es un plugin de laboratorio de Sulfur Cubes para servidores Paper & Spigot — genera, ajusta y administra cubos con físicas totalmente personalizadas.",
    url: "https://modrinth.com/plugin/sulfurlab",
    github: "https://github.com/33drygo/sulfurlab",
  },
  {
    name: "copa_sulfuro.exe",
    image: "/images/projects/copa_sulfuro.webp",
    tags: ["2026", "Soccer", "Funky", "Tournament"],
    description: "16 países se enfrentan en un torneo de fútbol en Minecraft. Regatea, patea y golea para llevar a tu país a la victoria.",
    url: "https://x.com/33drygo/status/2080787521005584461",
