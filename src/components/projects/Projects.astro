    github: "https://github.com/33drygo/xWhitelist",
  },
  {
    name: "speedrun_boss.exe",
    image: "/images/projects/speedrun_boss.webp",
    tags: ["2025", "Bosses", "Speedrun", "Duos"],
    description: "Un evento competitivo de speedrun donde 16 duos compiten para derrotar a todos los bosses de Minecraft y conseguir el título de Speedrun Boss.",
    url: "https://x.com/jose90YT/status/1909431398710104545",
    github: "https://github.com/33drygo/SpeedrunBoss",
  },
  {
    name: "xbossbar.exe",
    image: "https://wiki.drygo.dev/docs/xbossbar/og.jpg",
    tags: ["Boss Bar", "API", "Utilidad", "Información"],
    description: "xBossBar es un sistema robusto y flexible diseñado para mejorar tu servidor con BossBars totalmente personalizables.",
    url: "https://modrinth.com/plugin/xbossbar",
    github: "https://github.com/33drygo/xBossBar",
  },
  {
    name: "uhc_baguette.exe",
    image: "/images/projects/uhc_baguette.webp",
    tags: ["2025", "UHC", "PvP", "Francia"],
    description: "Servidor de Minecraft UHC con temática francesa y mecánicas personalizadas. Desarrollado con Turtle Club.",
    url: "https://x.com/turtleclubmc/status/1990156843549925699"
  },
  {
    name: "sector_x.exe",
    image: "/images/projects/sector_x.webp",
    tags: ["2026", "Hardcore", "Fallout", "Lore"],
    description: "Una serie de Minecraft hardcore donde los jugadores deberán enfrentarse a las consecuencias de un mundo sumido en la radiación.",
    url: "https://x.com/Sector__X/status/2010116104492859685"
  },
  {
    name: "minibook.exe",
    image: "https://wiki.drygo.dev/docs/minibook/og.jpg",
    tags: ["Libros", "Utilidad", "MiniMessage"],
    description: "MiniBook es un sistema potente y flexible que permite a administradores y desarrolladores crear, personalizar y distribuir libros interactivos a los jugadores.",
    url: "https://modrinth.com/plugin/minibook",
    github: "https://github.com/33drygo/MiniBook",
  },
  {
    name: "speedrun_boom.exe",
    image: "/images/projects/speedrun_boom.webp",
    tags: ["2026", "Speedrun", "Logros", "Duos"],
    description: "35 dúos compiten contra el tiempo desbloqueando logros para mantener una bomba bajo control. Si se detienen, explota.",
    url: "https://x.com/jose90YT/status/2036521683205439784"
  },
  {
    name: "chaotic_eggs.exe",
    image: "/images/projects/chaotic_eggs.webp",
    tags: ["2026", "Random", "PvP", "Minigame"],
    description: "100 jugadores abren huevos con loot aleatorio para equiparse y enfrentarse en la batalla final. ",
    url: "https://x.com/jose90YT/status/2057316331540668612"
  },
  {
