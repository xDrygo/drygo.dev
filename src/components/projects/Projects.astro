    tags: ["Teams", "Premium", "Cosmic"],
    description: "Stella es un plugin de equipos de jugadores impulsado por estrellas para servidores Spigot & Paper.",
    url: "https://modrinth.com/plugin/stella-was-taken",
    github: "https://github.com/33drygo/stella",
  },
  {
    name: "aevum.exe",
    image: "/images/projects/aevum.webp",
    tags: ["Time", "Toolkit", "Util"],
    description: "Aevum es un toolkit de Timers y Stopwatch para servidores Paper / Spigot.",
    url: "https://modrinth.com/plugin/aevum-was-taken",
