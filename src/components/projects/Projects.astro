---

<section id="resume" class="w-full max-w-7xl mx-auto">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
    {projects.map((project, projectIndex) => (
      <div class="border-2 border-gray-400 bg-gray-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col transition-transform hover:-translate-y-1 hover:scale-101">

        <!-- Titlebar -->
        <div class="h-8 bg-[#573070] flex items-center justify-between px-2 shrink-0">
          <span class="text-white text-sm font-bold truncate pr-2">{project.name}</span>
          <button aria-hidden="true" tabindex="-1"
            class="w-6 h-6 bg-gray-300 border border-t-white border-l-white border-b-black border-r-black flex items-center justify-center hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" class="w-3 h-3 text-black">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Mobile: horizontal -->
        <div class="flex sm:hidden flex-row flex-1">
          <div class="border-r-2 border-black shrink-0 w-24">
            <img src={project.image} alt={project.name} class="w-full h-full object-cover" />
          </div>
          <div class="p-2 flex flex-col flex-1 gap-2 min-w-0">
            <div class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-2 flex-1 font-family-comic">
              <p class="text-xs text-black leading-relaxed line-clamp-4">{project.description}</p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 min-w-0">
              <div class="relative flex-1 min-w-0">
                <div class="tag-fade-left pointer-events-none absolute left-0 top-0 h-full w-6 z-10 opacity-0 transition-opacity"
                  style="background: linear-gradient(to right, #d1d5db, transparent)"></div>
                <div class="tag-fade-right pointer-events-none absolute right-0 top-0 h-full w-6 z-10 opacity-0 transition-opacity"
                  style="background: linear-gradient(to left, #d1d5db, transparent)"></div>
                <div class="tag-scroll flex gap-1 overflow-x-auto scrollbar-none" data-index={`m-${projectIndex}`}>
                  {project.tags.map((tag) => (
                    <span class="px-1.5 py-0.5 bg-gray-200 border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 text-[9px] font-bold text-black whitespace-nowrap shrink-0 cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="flex gap-1 shrink-0">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer"
                    aria-label={`GitHub de ${project.name}`}
                    class="px-2 py-1 bg-gray-300 border-2 border-t-white border-l-white border-b-black border-r-black text-black hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white inline-flex items-center">
                    <GitHub class="size-4 text-black" />
                  </a>
                )}
                <a href={project.url} target="_blank" rel="noopener noreferrer"
                  class="px-2 py-1 bg-gray-300 border-2 border-t-white border-l-white border-b-black border-r-black text-black font-bold text-xs hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white whitespace-nowrap">
                  Info +
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Desktop: vertical -->
        <div class="hidden sm:flex flex-col flex-1">
          <img src={project.image} alt={project.name} class="w-full h-44 object-cover" />
          <div class="p-3 flex flex-col flex-1 gap-3">
            <div class="bg-white border-2 border-t-gray-600 border-l-gray-600 border-b-white border-r-white p-2 flex-1 font-family-comic">
              <p class="text-sm text-black leading-relaxed">{project.description}</p>
            </div>
            <div class="flex items-center gap-2 shrink-0 min-w-0">
              <div class="relative flex-1 min-w-0">
                <div class="tag-fade-left pointer-events-none absolute left-0 top-0 h-full w-8 z-10 opacity-0 transition-opacity"
                  style="background: linear-gradient(to right, #d1d5db, transparent)"></div>
                <div class="tag-fade-right pointer-events-none absolute right-0 top-0 h-full w-8 z-10 opacity-0 transition-opacity"
                  style="background: linear-gradient(to left, #d1d5db, transparent)"></div>
                <div class="tag-scroll flex gap-1.5 overflow-x-auto scrollbar-none" data-index={`d-${projectIndex}`}>
                  {project.tags.map((tag) => (
                    <span class="px-2 py-0.5 bg-gray-200 border-2 border-t-white border-l-white border-b-gray-600 border-r-gray-600 text-xs font-bold text-black whitespace-nowrap shrink-0 cursor-default">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="flex gap-2 shrink-0">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer"
                    aria-label={`GitHub de ${project.name}`}
                    class="px-3 py-2 bg-gray-300 border-2 border-t-white border-l-white border-b-black border-r-black text-black hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white inline-flex items-center transition-transform hover:scale-105">
                    <GitHub class="size-4 text-black" />
                  </a>
                )}
                <a href={project.url} target="_blank" rel="noopener noreferrer"
                  class="px-5 py-2 bg-gray-300 border-2 border-t-white border-l-white border-b-black border-r-black text-black font-bold text-sm hover:bg-gray-400 active:border-t-black active:border-l-black active:border-b-white active:border-r-white transition-transform hover:scale-105 whitespace-nowrap">
                  Mas info. +
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    ))}
  </div>
</section>

<script>
  function updateFades(el: HTMLElement) {
    const wrapper = el.closest(".relative");
    if (!wrapper) return;
    const fadeLeft = wrapper.querySelector<HTMLElement>(".tag-fade-left");
    const fadeRight = wrapper.querySelector<HTMLElement>(".tag-fade-right");
    if (fadeLeft) fadeLeft.style.opacity = el.scrollLeft > 0 ? "1" : "0";
    if (fadeRight) fadeRight.style.opacity = el.scrollLeft + el.clientWidth < el.scrollWidth - 1 ? "1" : "0";
  }

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLElement>(".tag-scroll").forEach((el) => {
      // Estado inicial
      updateFades(el);
      // Al hacer scroll
      el.addEventListener("scroll", () => updateFades(el));
      // Al cambiar el tamaño
      new ResizeObserver(() => updateFades(el)).observe(el);
    });
  });
</script>