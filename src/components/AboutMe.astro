---
import Java from "./icons/Java.astro";
import JavaScript from "./icons/JavaScript.astro";
import HTMLIcon from "./icons/HTMLIcon.astro";
import CSSIcon from "./icons/CSSIcon.astro";
import Database from "./icons/Database.astro";
import MySQL from "./icons/MySQL.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import ReactIcon from "./icons/ReactIcon.astro";
import TailwindCSS from "./icons/TailwindCSS.astro";
import DiscordJS from "./icons/DiscordJS.astro";
import Maven from "./icons/Maven.astro";
import Git from "./icons/Git.astro";
import VSCode from "./icons/VSCode.astro";
import IntelliJIdea from "./icons/IntelliJIdea.astro";
import GitHub from "./icons/GitHub.astro";
import Vercel from "./icons/Vercel.astro";
import Render from "./icons/Render.astro";
---

<div
  class="flex flex-col xl:flex-row mx-auto mt-20 lg:mt-30 items-start sm:items-stretch sm:gap-x-10 xl:gap-x-10"
>
  <!-- Imagen -->
  <div
    class="w-full xl:w-1/3 flex justify-center mb-6 sm:mb-0
           order-1 sm:order-2 lg:order-1 xl:order-2"
  >
    <div
      class="group relative w-full
         aspect-[8/2] xl:aspect-auto
         h-auto sm:h-full overflow-hidden rounded-lg shadow-lg border-1 border-white/50"
    >
      <img
        src="/images/aboutme.webp"
        alt="Render of Drygo's Minecraft skin"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
      <span
        class="absolute bottom-2 right-2 bg-black/70 text-white py-1 px-2 rounded-xl
           border-1 border-white/10 text-sm opacity-0 group-hover:opacity-100
           transition-opacity duration-500 ease-in-out cursor-default"
      >
        Render made by <a
          href="https://x.com/kansuoficial"
          target="_blank"
          rel="noopener"
          aria-label="Visit the render author Twitter."
          class="font-semibold text-[#bbff33] bg-[#bbff33]/5 hover:bg-[#bbff33]/15 px-2 rounded-lg transition-all hover:underline"
          >@kansuoficial</a
        >
      </span>
    </div>
  </div>

  <!-- Contenido -->
  <div
    class="w-full xl:w-2/3 flex flex-col justify-center order-2 xl:order-1 text-sm lg:text-base"
  >
    <h2 class="text-left md:text-2xl text-white/90 sm:mt-5 lg:mt-10 xl:mt-0">
      Who's Drygo? 💫
    </h2>
    <p class="text-left ml-1 text-white/80 mt-4 text-pretty">
      I am a <span class="font-semibold text-white">Plugin Developer</span> and
      <span class="font-semibold text-white">Server/Event Creator</span> in Minecraft,
      as well as a Web Pages and Discord Bots creator. From Mexico, I have gained
      experience in <span class="font-semibold text-white">server creation</span
      > since 2020, hosting <span class="font-semibold text-white"
        >my first event</span
      >, Party Fest in September 2024.
    </p>
    <p
      class="text-left ml-1 text-white/80 mt-4 text-pretty bg-white/2 border-1 border-white/10 py-2 px-3 rounded-lg"
    >
      Currently <span class="font-semibold text-white">HEAD ADMIN</span> of
      <a
        href="https://link.drygo.dev/turtle"
        target="_blank"
        rel="noopener"
        aria-label="Visit Turtle Club website"
        class="font-semibold text-[#bbff33] bg-[#bbff33]/5 hover:bg-[#bbff33]/15 px-2 rounded-lg transition-all hover:underline"
        >Turtle Club</a
      >, and have also worked in other studios and projects such as:
      <a
        href="http://link.drygo.dev/kairi"
        target="_blank"
        rel="noopener"
        aria-label="Join to Kairi Club's Discord server."
        class="font-semibold text-[#ffbce1] bg-[#ffbce1]/5 hover:bg-[#ffbce1]/15 px-2 rounded-lg transition-all hover:underline"
        >Kairi Club</a
      >,
      <a
        href="http://link.drygo.dev/sector_x"
        target="_blank"
        rel="noopener"
        aria-label="Visit Sector X Twitter profile."
        class="font-semibold text-[#719cb4] bg-[#719cb4]/5 hover:bg-[#719cb4]/15 px-2 rounded-lg transition-all hover:underline"
        >Sector X</a
      >, and more.
    </p>
    <p class="text-left ml-1 text-white/80 mt-4 text-pretty">
      Using the tools provided by <span class="font-semibold text-white"
        >PaperMC</span
      >, I have been able to create experiences that impact the people
      participating, bringing fun and more emotions through this medium.
    </p>
    <div
      class="w-full h-auto bg-white/5 mt-4 rounded-2xl p-4 border-1 border-white/10"
    >
      <h3 class="text-left text-md lg:text-lg text-white/90">Languages ☕</h3>
      <div class="flex flex-wrap gap-2 mt-2 cursor-default">
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Java class="size-4 mr-2" />
          Java
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <HTMLIcon class="size-4 mr-2" />
          HTML
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <CSSIcon class="size-4 mr-2" />
          CSS
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <JavaScript class="size-4 mr-2" />
          JavaScript
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Database class="size-4 mr-2" />
          SQL
        </span>
      </div>
    </div>
    <div
      class="w-full h-auto bg-white/5 mt-4 rounded-2xl p-4 border-1 border-white/10"
    >
      <h3 class="text-left text-md lg:text-lg text-white/90">
        Frameworks & Libraries 📚
      </h3>
      <div class="flex flex-wrap gap-2 mt-2 cursor-default">
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <AstroIcon class="size-4 mr-2" />
          Astro
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <ReactIcon class="size-4 mr-2" />
          React
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <TailwindCSS class="size-4 mr-2" />
          Tailwind CSS
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <DiscordJS class="size-5 mr-2" />
          Discord.js
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <img
            src="/images/papermc_logo.webp"
            alt="PaperMC logo"
            class="w-4 h-4 mr-2"
          />
          Paper
        </span>
      </div>
    </div>
    <div
      class="w-full h-auto bg-white/5 mt-4 rounded-2xl p-4 border-1 border-white/10"
    >
      <h3 class="text-left text-md lg:text-lg text-white/90">Tools 🛠️</h3>
      <div class="flex flex-wrap gap-2 mt-2 cursor-default">
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Maven class="size-4 mr-2" />
          Apache Maven
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Git class="size-4 mr-2" />
          Git
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <VSCode class="size-4 mr-2" />
          Visual Studio Code
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <IntelliJIdea class="size-4 mr-2" />
          Intelli J Idea
        </span>
      </div>
    </div>
    <div
      class="w-full h-auto bg-white/5 mt-4 rounded-2xl p-4 border-1 border-white/10"
    >
      <h3 class="text-left text-md lg:text-md lg:text-lg text-white/90">
        Clouds & Providers ☁️
      </h3>
      <div class="flex flex-wrap gap-2 mt-2 cursor-default">
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <GitHub class="size-4 mr-2" />
          GitHub
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <MySQL class="size-4 mr-2" />
          MySQL
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Vercel class="size-4 mr-2" />
          Vercel
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <Render class="size-6 -ml-1" />
          Render
        </span>
        <span
          class="flex items-center bg-white/10 text-white px-3 py-1 rounded-full text-xs sm:text-sm hover:scale-103 hover:bg-white/15 transition-all border-1 border-white/10"
        >
          <img
            src="/images/pterodactyl.webp"
            alt="Pterodactyl logo"
            class="w-5 h-5 mr-1 -ml-1"
          />
          Pterodactyl-based panels
        </span>
      </div>
    </div>
  </div>
</div>
